# =============================================================================
# Tamil Literature & Philosophy Platform — .gitignore
# =============================================================================

# ── Environment & Secrets (NEVER push these) ──────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.staging
.env.test
.env.test.local
*.pem
*.key
*.cert

# ── Node.js Dependencies ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Vite Build Output ─────────────────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Vite Cache ────────────────────────────────────────────────────────────────
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ── Editor & IDE Files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.DS_Store
Thumbs.db

# ── OS Generated Files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log
yarn-debug.log

# ── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/

# ── Misc ─────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
